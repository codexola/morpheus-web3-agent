# Agent identity
AGENT_NAME=Web3Dev AI
AGENT_VERSION=1.0.0
AGENT_DESCRIPTION=Autonomous Web3 and AI development agent

# Runtime
ENVIRONMENT=development
SERVICE_STATE=RUNNING
LOG_LEVEL=INFO
COMMIT_SHA=

# Auth / Morpheus
# Leave unset for open registration testing. Set both in production if you want auth.
MORPHEUS_SHARED_SECRET=
CALLBACK_SHARED_SECRET=
REQUIRE_SHARED_SECRET=false
MORPHEUS_API_URL=https://api.morpheusprotocol.dev

# LLM (optional — agents work with pattern analysis when unset)
OPENAI_API_KEY=
PRIMARY_MODEL=gpt-4o-mini
SECONDARY_MODEL=gpt-4o-mini
FAST_MODEL=gpt-4o-mini
REASONING_MODEL=gpt-4o

# Database (optional — in-memory store used when unset)
DATABASE_URL=
REDIS_URL=

# Blockchain RPC — omit these keys to use built-in public defaults.
# Do NOT set them to empty strings in Vercel (blank values are ignored, but omit is clearer).
# ETH_RPC_URL=https://ethereum.publicnode.com
# BASE_RPC_URL=https://mainnet.base.org
# ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
# POLYGON_RPC_URL=https://polygon-rpc.com
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Cost / limits
MAX_AGENT_STEPS=12
MAX_TOOL_CALLS=25
MAX_LLM_RETRIES=2
RATE_LIMIT_PER_MINUTE=60
MAX_ACTIVE_TASKS=10
MAX_JSON_BYTES=2097152

# Monitoring
SENTRY_DSN=

# Public payout address only (never private keys)
PAYOUT_ADDRESS=
