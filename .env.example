# Agent identity
AGENT_NAME=Web3Dev AI
AGENT_VERSION=1.1.0
AGENT_DESCRIPTION=Autonomous Web3 and AI development agent

# Runtime
ENVIRONMENT=development
SERVICE_STATE=RUNNING
LOG_LEVEL=INFO
COMMIT_SHA=

# Auth / Morpheus
MORPHEUS_SHARED_SECRET=
CALLBACK_SHARED_SECRET=
REQUIRE_SHARED_SECRET=false
MORPHEUS_API_URL=https://api.morpheusprotocol.dev

# LLM (add manually in Vercel)
OPENAI_API_KEY=
PRIMARY_MODEL=gpt-4o-mini
SECONDARY_MODEL=gpt-4o-mini
FAST_MODEL=gpt-4o-mini
REASONING_MODEL=gpt-4o

# Database — provisioned automatically via Vercel Neon integration.
# Locally: run `vercel env pull .env.local`
DATABASE_URL=
POSTGRES_URL=

# Redis / Upstash — optional; accept Upstash marketplace terms then install
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
REDIS_URL=

# Blockchain RPC — omit to use built-in public defaults
# ETH_RPC_URL=
# BASE_RPC_URL=
# ARBITRUM_RPC_URL=
# POLYGON_RPC_URL=
# SOLANA_RPC_URL=

# Cost / limits
MAX_AGENT_STEPS=12
MAX_TOOL_CALLS=25
MAX_LLM_RETRIES=2
RATE_LIMIT_PER_MINUTE=60
MAX_ACTIVE_TASKS=10
MAX_JSON_BYTES=2097152

# Monitoring (add manually)
SENTRY_DSN=

# Public payout address only (never private keys)
PAYOUT_ADDRESS=
